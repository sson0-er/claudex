#!/usr/bin/env bash
# Deterministically pre-merges the leftover low-severity findings of every
# task in a feature so the triage agent judges only the merged items, not
# every raw restatement. Dedup key is role + normalized title.
set -u

usage() {
  echo "Usage: claudex-findings-triage --tasks-dir DIR --out FILE" >&2
  exit 2
}

tasks_dir="" out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tasks-dir) [ $# -ge 2 ] || usage; tasks_dir="$2"; shift 2 ;;
    --out) [ $# -ge 2 ] || usage; out="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$tasks_dir" ] && [ -n "$out" ] || usage
[ -d "$tasks_dir" ] || { echo "no such directory: $tasks_dir" >&2; exit 2; }

# Tag each low finding with its task id and reviewer role, taken from
# "<task>.findings.<role>.json". No matching files is not an error: it
# just yields zero findings.
tagged="$(mktemp "${TMPDIR:-/tmp}/claudex-triage.XXXXXX")"
trap 'rm -f "$tagged"' EXIT
: > "$tagged"
for f in "$tasks_dir"/*.findings.*.json; do
  [ -e "$f" ] || continue
  jq -e '.findings | type == "array" and all(.[]; type == "object" and (.severity | IN("high","medium","low")))' "$f" >/dev/null 2>&1 || { echo "invalid findings json (findings must be an array of objects with severity high|medium|low): $f" >&2; exit 2; }
  base="$(basename "$f" .json)"
  task="${base%%.findings.*}"
  role="${base##*.findings.}"
  jq -c --arg task "$task" --arg role "$role" \
    '.findings[] | select(.severity == "low") | {task: $task, role: $role, title: .title, location: .location, detail: .detail}' \
    "$f" >> "$tagged" || exit 2
done

raw="$(jq -s 'length' "$tagged")"

mkdir -p "$(dirname "$out")"

if [ "$raw" -eq 0 ]; then
  {
    echo "# Low findings (merged)"
    echo
    echo "raw: 0, merged: 0, by role: quality 0, security 0, spec 0, tests 0"
    echo
    echo "No low findings."
  } > "$out"
  echo "raw: 0 merged: 0"
  exit 0
fi

# Group by role + normalized title (lowercase, whitespace collapsed to one
# space, leading/trailing space and a trailing "." or ":" removed) and
# assign stable ids L001.. in that sorted order. group_by/sort are stable,
# so the first element of each group is the first occurrence.
groups="$(mktemp "${TMPDIR:-/tmp}/claudex-triage-groups.XXXXXX")"
trap 'rm -f "$tagged" "$groups"' EXIT
jq -s '
  def norm: ascii_downcase | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "") | sub("[.:]+$"; "") | sub(" +$"; "");
  map(. + {_norm: (.title | norm)})
  | group_by([.role, ._norm])
  | to_entries
  | map(
      .value as $g
      | $g[0] as $first
      | ((.key + 1) | tostring) as $n
      | {
          id: ("L" + (if ($n | length) == 1 then "00" + $n elif ($n | length) == 2 then "0" + $n else $n end)),
          role: $first.role,
          bucket: (if ($first._norm | startswith("design ambiguity:")) then "B" else "toTriage" end),
          title: $first.title,
          count: ($g | length),
          tasks: ([$g[].task] | unique),
          locations: (([$g[].location] | map(select(. != "")) | unique))[0:5],
          detail: (([$g[].detail] | map(select(. != "")))[0] // "")
        }
    )
' "$tagged" > "$groups"

merged="$(jq 'length' "$groups")"
role_count() { jq --arg r "$1" '[.[] | select(.role == $r)] | length' "$groups"; }
rq="$(role_count quality)"; rs="$(role_count security)"; rsp="$(role_count spec)"; rt="$(role_count tests)"

item_line() {
  jq -r '
    "- \(.id) [\(.role)] \(.title) (\(.count) occurrences; tasks: \([.tasks[]] | join(", "))) — location: " +
    (if (.locations | length) == 0 then "(none)" else ([.locations[]] | join("; ")) end) +
    " — detail: " + (if .detail == "" then "(none)" else .detail end)
  '
}

role_section() {
  role="$1"
  items="$(jq --arg r "$role" '[.[] | select(.bucket == "toTriage" and .role == $r)]' "$groups")"
  [ "$(printf '%s' "$items" | jq 'length')" -eq 0 ] && return
  echo "### $role"
  printf '%s' "$items" | jq -c '.[]' | while IFS= read -r line; do
    printf '%s\n' "$line" | item_line
  done
}

{
  echo "# Low findings (merged)"
  echo
  echo "raw: $raw, merged: $merged, by role: quality $rq, security $rs, spec $rsp, tests $rt"
  echo

  b_items="$(jq '[.[] | select(.bucket == "B")]' "$groups")"
  if [ "$(printf '%s' "$b_items" | jq 'length')" -gt 0 ]; then
    echo "## Pre-assigned B (design ambiguity)"
    echo
    printf '%s' "$b_items" | jq -c '.[]' | while IFS= read -r line; do
      printf '%s\n' "$line" | item_line
    done
    echo
  fi

  triage_count="$(jq '[.[] | select(.bucket == "toTriage")] | length' "$groups")"
  if [ "$triage_count" -gt 0 ]; then
    echo "## To triage"
    echo
    for role in quality security spec tests; do
      role_section "$role"
    done
  fi
} > "$out"

echo "raw: $raw merged: $merged"
